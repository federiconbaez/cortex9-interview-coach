{
  "uid": "cx9-overview",
  "title": "CORTEX-9 Interview Coach",
  "tags": [
    "cortex9"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servicios arriba",
      "datasource": {
        "type": "prometheus",
        "uid": "cx9-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "up{job=~\"speech|backend\"}",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Voz en curso",
      "datasource": {
        "type": "prometheus",
        "uid": "cx9-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "speech_in_flight",
          "legendFormat": "en curso"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Muletillas detectadas (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "cx9-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "sum by (language) (increase(speech_stt_fillers_total[1h]))",
          "legendFormat": "{{language}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fallbacks TTS (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "cx9-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "sum(increase(speech_tts_fallback_total[1h]))",
          "legendFormat": "fallbacks"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Voz: solicitudes por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "cx9-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "sum by (endpoint, status) (rate(speech_requests_total{endpoint=~\"/stt|/tts\"}[5m]))",
          "legendFormat": "{{endpoint}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Voz: latencia p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "cx9-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, endpoint) (rate(speech_request_duration_seconds_bucket{endpoint=~\"/stt|/tts\"}[5m])))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(speech_request_duration_seconds_bucket{endpoint=~\"/stt|/tts\"}[5m])))",
          "legendFormat": "p95 {{endpoint}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "STT: segundos de audio por minuto",
      "datasource": {
        "type": "prometheus",
        "uid": "cx9-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cx9-prometheus"
          },
          "expr": "sum by (language) (rate(speech_stt_audio_seconds_total[5m])) * 60",
          "legendFormat": "{{language}}"
        }
      ]
    },
    {
      "id": 8,
