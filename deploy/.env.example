# Copiá a deploy/.env (ignorado por git) y completá. Nunca subas deploy/.env.
# Los valores vacíos significan "desactivado".

# --- Base de datos (local, red interna) ---
POSTGRES_DB=cx9
POSTGRES_USER=cx9
POSTGRES_PASSWORD=cambiame-por-una-clave-larga

# --- Backend ---
CX9_ENV=prod
# Hash argon2id de tu contraseña (obligatorio en Docker). Generalo con:
#   printf 'tu-clave\n' | docker run --rm -i cortex9/backend:local hash-password
#   (sin Docker: cd backend && printf 'tu-clave\n' | go run ./cmd/coach hash-password)
# Va entre comillas SIMPLES: el hash tiene '$' y compose lo interpolaría.
CX9_PASSWORD_HASH=''
# Solo en dev sin Docker y escuchando en 127.0.0.1:
# CX9_DEV_NO_AUTH=1
CX9_CORS_ORIGINS=
CX9_LOG_TRANSCRIPTS=0
# json | text
CX9_LOG_FORMAT=json
CX9_BACKEND_PORT=8080
CX9_FRONTEND_PORT=5173

# --- Proveedor LLM: lo único que puede salir de la máquina (solo texto, nunca audio) ---
# mock | ollama | openai | anthropic | xai
CX9_LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
# Ollama en el host. Vacío en Docker usa http://host.docker.internal:11434; sin Docker, http://127.0.0.1:11434
CX9_OLLAMA_URL=

# --- Servicio de voz ---
# real | mock (mock: sin modelos, respuestas deterministas)
CX9_SPEECH_MODE=real
# Opcional: Bearer entre backend y voz.
CX9_SPEECH_TOKEN=
CX9_MODELS_DIR=../models
SPEECH_WITH_MODELS=true
# tiny | base | small (más grande = más RAM y CPU)
SPEECH_WHISPER_MODEL=small
SPEECH_WHISPER_CPU_THREADS=2
SPEECH_PIPER_VOICE_ES_AR_FILE=es_AR-daniela-high.onnx
SPEECH_PIPER_VOICE_EN_US_FILE=en_US-lessac-medium.onnx
SPEECH_MAX_CONCURRENCY=1
SPEECH_MEM_LIMIT=1g

# --- Observabilidad (solo 127.0.0.1) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiame-tambien
